# ------------------------------------------------------------ database.py ------------------------------------------------------------
# -*- coding: utf-8 -*-
"""SQLite3 数据层：清单 / 任务 / 设置"""
import os
import shutil
import sqlite3
from datetime import date, datetime, timedelta

APP_NAME = "TaskFlow"


def db_path():
    base = os.getenv("APPDATA") or os.path.expanduser("~")
    folder = os.path.join(base, APP_NAME)
    os.makedirs(folder, exist_ok=True)
    return os.path.join(folder, "todo.db")


SCHEMA = """
CREATE TABLE IF NOT EXISTS lists (
    id         INTEGER PRIMARY KEY AUTOINCREMENT,
    name       TEXT NOT NULL UNIQUE,
    sort_order INTEGER DEFAULT 0,
    created_at TEXT DEFAULT (datetime('now','localtime'))
);
CREATE TABLE IF NOT EXISTS tasks (
    id           INTEGER PRIMARY KEY AUTOINCREMENT,
    list_id      INTEGER NOT NULL REFERENCES lists(id) ON DELETE CASCADE,
    parent_id    INTEGER REFERENCES tasks(id) ON DELETE CASCADE,
    title        TEXT NOT NULL,
    notes        TEXT DEFAULT '',
    priority     INTEGER DEFAULT 1,
    due_date     TEXT,
    starred      INTEGER DEFAULT 0,
    completed    INTEGER DEFAULT 0,
    completed_at TEXT,
    sort_order   INTEGER DEFAULT 0,
    created_at   TEXT DEFAULT (datetime('now','localtime')),
    updated_at   TEXT DEFAULT (datetime('now','localtime'))
);
CREATE TABLE IF NOT EXISTS settings (
    key   TEXT PRIMARY KEY,
    value TEXT
);
"""

# 索引在 _migrate() 补列之后创建(旧库无 parent_id 列时先建索引会失败)
POST_MIGRATE_INDEXES = """
CREATE INDEX IF NOT EXISTS idx_tasks_list ON tasks(list_id);
CREATE INDEX IF NOT EXISTS idx_tasks_completed ON tasks(completed);
CREATE INDEX IF NOT EXISTS idx_tasks_parent ON tasks(parent_id);
"""

PRIO_LOW, PRIO_MID, PRIO_HIGH, PRIO_URGENT = 0, 1, 2, 3
PRIORITY_NAMES = {0: "低", 1: "中", 2: "高", 3: "紧急"}


def now_str():
    return datetime.now().strftime("%Y-%m-%d %H:%M:%S")


class Database:
    SCHEMA_VERSION = 1

    def __init__(self):
        self.conn = sqlite3.connect(db_path(), check_same_thread=False)
        self.conn.row_factory = sqlite3.Row
        self.conn.execute("PRAGMA foreign_keys=ON")
        self.conn.execute("PRAGMA busy_timeout=3000")
        try:
            self.conn.execute("PRAGMA journal_mode=WAL")
            self.conn.execute("PRAGMA synchronous=NORMAL")
        except sqlite3.DatabaseError:
            pass
        self.conn.executescript(SCHEMA)
        self._migrate()
        self.conn.executescript(POST_MIGRATE_INDEXES)
        self.conn.execute(f"PRAGMA user_version={self.SCHEMA_VERSION}")
        self.conn.commit()
        self._ensure_default_list()

    def _migrate(self):
        """旧库升级: 补充子任务字段, 迁移前备份"""
        cols = {r["name"] for r in self.conn.execute("PRAGMA table_info(tasks)")}
        if "parent_id" not in cols or "sort_order" not in cols:
            try:
                shutil.copy2(db_path(), db_path() + ".bak-" +
                             datetime.now().strftime("%Y%m%d%H%M%S"))
            except OSError:
                pass
        if "parent_id" not in cols:
            self.conn.execute(
                "ALTER TABLE tasks ADD COLUMN parent_id INTEGER REFERENCES tasks(id) ON DELETE CASCADE")
        if "sort_order" not in cols:
            self.conn.execute("ALTER TABLE tasks ADD COLUMN sort_order INTEGER DEFAULT 0")
        # 旧库列可能无 DEFAULT, 补列后归一化 NULL 值
        self.conn.execute("UPDATE tasks SET completed=0 WHERE completed IS NULL")
        self.conn.execute("UPDATE tasks SET starred=0 WHERE starred IS NULL")
        self.conn.execute("UPDATE tasks SET priority=1 WHERE priority IS NULL")
        self.conn.execute("UPDATE tasks SET notes='' WHERE notes IS NULL")

    def _ensure_default_list(self):
        if not self.conn.execute("SELECT 1 FROM lists LIMIT 1").fetchone():
            self.add_list("我的任务")

    # ---------------- settings ----------------
    def get_setting(self, key, default=None, type_=None):
        row = self.conn.execute("SELECT value FROM settings WHERE key=?", (key,)).fetchone()
        if row is None:
            return default
        value = row["value"]
        if type_ is not None:
            try:
                return type_(value)
            except (TypeError, ValueError):
                return default
        return value

    def set_setting(self, key, value):
        self.conn.execute(
            "INSERT INTO settings(key,value) VALUES(?,?) "
            "ON CONFLICT(key) DO UPDATE SET value=excluded.value", (key, str(value)))
        self.conn.commit()

    # ---------------- lists ----------------
    def get_lists(self):
        rows = self.conn.execute(
            "SELECT l.*, (SELECT COUNT(*) FROM tasks t WHERE t.list_id=l.id"
            " AND t.completed=0 AND t.parent_id IS NULL) AS pending "
            "FROM lists l ORDER BY l.sort_order, l.id").fetchall()
        return [dict(r) for r in rows]

    def add_list(self, name):
        name = (name or "").strip()
        if not name:
            name = "未命名清单"
        row = self.conn.execute("SELECT id FROM lists WHERE name=?", (name,)).fetchone()
        if row:
            return row["id"]
        cur = self.conn.execute("INSERT INTO lists(name, sort_order) VALUES(?,?)",
                                (name, self.conn.execute("SELECT COALESCE(MAX(sort_order),0)+1 FROM lists").fetchone()[0]))
        self.conn.commit()
        return cur.lastrowid

    def rename_list(self, list_id, name):
        """重命名清单, 重名返回 False"""
        name = (name or "").strip()
        if not name:
            return False
        row = self.conn.execute(
            "SELECT 1 FROM lists WHERE name=? AND id<>?", (name, list_id)).fetchone()
        if row:
            return False
        self.conn.execute("UPDATE lists SET name=? WHERE id=?", (name, list_id))
        self.conn.commit()
        return True

    def delete_list(self, list_id):
        self.conn.execute("DELETE FROM lists WHERE id=?", (list_id,))
        self.conn.commit()

    # ---------------- tasks ----------------
    def add_task(self, list_id, title, notes="", priority=PRIO_MID, due_date=None,
                 parent_id=None):
        if parent_id is not None:
            parent = self.get_task(parent_id)
            if not parent or parent["parent_id"]:
                parent_id = None  # 仅支持两级
            else:
                list_id = parent["list_id"]
        cur = self.conn.execute(
            "INSERT INTO tasks(list_id,parent_id,title,notes,priority,due_date,sort_order,"
            "completed,starred) VALUES(?,?,?,?,?,?,?,0,0)",
            (list_id, parent_id, title.strip(), notes, priority, due_date,
             self.conn.execute(
                 "SELECT COALESCE(MAX(sort_order),0)+1 FROM tasks WHERE parent_id IS ?",
                 (parent_id,)).fetchone()[0]))
        self.conn.commit()
        return cur.lastrowid

    def add_subtask(self, parent_id, title, **kwargs):
        parent = self.get_task(parent_id)
        # 已完成的父任务新增未完成子任务时, 自动重新打开父任务
        if parent and parent["completed"]:
            self.update_task(parent_id, completed=0, completed_at=None)
        return self.add_task(None, title, parent_id=parent_id, **kwargs)

    def get_subtasks(self, parent_id):
        rows = self.conn.execute(
            "SELECT * FROM tasks WHERE parent_id=? ORDER BY sort_order, id",
            (parent_id,)).fetchall()
        return [dict(r) for r in rows]

    def update_task(self, task_id, **fields):
        if not fields:
            return
        fields["updated_at"] = now_str()
        cols = ", ".join(f"{k}=?" for k in fields)
        self.conn.execute(f"UPDATE tasks SET {cols} WHERE id=?", (*fields.values(), task_id))
        self.conn.commit()

    def toggle_complete(self, task_id, completed):
        self.update_task(task_id, completed=int(completed),
                         completed_at=now_str() if completed else None)
        # 勾选联动: 父任务同步全部子任务
        t = self.get_task(task_id)
        if t and not t["parent_id"]:
            self.conn.execute(
                "UPDATE tasks SET completed=?, completed_at=?, updated_at=? WHERE parent_id=?",
                (int(completed), now_str() if completed else None, now_str(), task_id))
            self.conn.commit()
            return
        # 自动完成联动: 子任务全部完成时自动完成父任务
        if t and t["parent_id"] and completed and self.get_setting("auto_complete", "1") == "1":
            parent = self.get_task(t["parent_id"])
            if parent and not parent["completed"]:
                left = self.conn.execute(
                    "SELECT COUNT(*) c FROM tasks WHERE parent_id=? AND completed=0",
                    (t["parent_id"],)).fetchone()["c"]
                if left == 0:
                    self.toggle_complete(t["parent_id"], True)
        # 反向联动: 取消子任务完成时, 若父任务已完成则重新打开
        if t and t["parent_id"] and not completed:
            parent = self.get_task(t["parent_id"])
            if parent and parent["completed"]:
                self.update_task(t["parent_id"], completed=0, completed_at=None)

    def toggle_star(self, task_id, starred):
        self.update_task(task_id, starred=int(starred))

    def delete_task(self, task_id):
        self.conn.execute("DELETE FROM tasks WHERE id=?", (task_id,))
        self.conn.commit()

    def move_task(self, task_id, list_id):
        self.update_task(task_id, list_id=list_id)
        t = self.get_task(task_id)
        if t and not t["parent_id"]:
            self.conn.execute("UPDATE tasks SET list_id=? WHERE parent_id=?",
                              (list_id, task_id))
            self.conn.commit()

    def get_task(self, task_id):
        r = self.conn.execute("SELECT * FROM tasks WHERE id=?", (task_id,)).fetchone()
        return dict(r) if r else None

    def get_tasks(self, view="all", list_id=None, search="", sort="created",
                  show_completed=True):
        """查询顶级任务(含子任务进度). view: all/today/overdue/starred/done;
        sort: created/due/priority. 今天/逾期/搜索会联动匹配子任务."""
        where = ["t.parent_id IS NULL"]
        params = []
        if view == "today":
            where.append(
                "(t.completed=0 AND ("
                " (t.due_date IS NOT NULL AND date(t.due_date) = ?)"
                " OR EXISTS(SELECT 1 FROM tasks s WHERE s.parent_id=t.id"
                "           AND s.completed=0 AND s.due_date IS NOT NULL AND date(s.due_date) = ?)))")
            params.extend([date.today().isoformat(), date.today().isoformat()])
        elif view == "overdue":
            where.append(
                "(t.completed=0 AND ("
                " (t.due_date IS NOT NULL AND date(t.due_date) < ?)"
                " OR EXISTS(SELECT 1 FROM tasks s WHERE s.parent_id=t.id"
                "           AND s.completed=0 AND s.due_date IS NOT NULL AND date(s.due_date) < ?)))")
            params.extend([date.today().isoformat(), date.today().isoformat()])
        elif view == "starred":
            where.append("t.starred=1")
            if not show_completed:
                where.append("t.completed=0")
        elif view == "done":
            where.append("t.completed=1")
        elif not show_completed:
            where.append("t.completed=0")
        if list_id is not None:
            where.append("t.list_id=?")
            params.append(list_id)
        if search:
            where.append(
                "(t.title LIKE ? OR t.notes LIKE ?"
                " OR EXISTS(SELECT 1 FROM tasks s WHERE s.parent_id=t.id"
                "           AND (s.title LIKE ? OR s.notes LIKE ?)))")
            like = f"%{search}%"
            params.extend([like, like, like, like])
        order = {
            "due": "t.completed ASC, (t.due_date IS NULL) ASC, t.due_date ASC, t.priority DESC, t.id DESC",
            "priority": "t.completed ASC, t.priority DESC, (t.due_date IS NULL) ASC, t.due_date ASC, t.id DESC",
        }.get(sort, "t.completed ASC, t.starred DESC, t.id DESC")
        sql = ("SELECT t.*,"
               " (SELECT COUNT(*) FROM tasks s WHERE s.parent_id=t.id) AS sub_count,"
               " (SELECT COUNT(*) FROM tasks s WHERE s.parent_id=t.id AND s.completed=1) AS sub_done"
               " FROM tasks t")
        if where:
            sql += " WHERE " + " AND ".join(where)
        sql += " ORDER BY " + order
        return [dict(r) for r in self.conn.execute(sql, params).fetchall()]

    def get_subtasks_for(self, parent_ids):
        """批量查询多个父任务的子任务: {parent_id: [subtask, ...]}"""
        ids = [i for i in parent_ids if i is not None]
        if not ids:
            return {}
        marks = ",".join("?" * len(ids))
        rows = self.conn.execute(
            f"SELECT * FROM tasks WHERE parent_id IN ({marks}) ORDER BY sort_order, id",
            ids).fetchall()
        grouped = {}
        for r in rows:
            grouped.setdefault(r["parent_id"], []).append(dict(r))
        return grouped

    # ---------------- stats ----------------
    def get_due_tasks_between(self, start_iso, end_iso, search="", show_completed=True):
        """返回 [start, end] 区间内所有带截止日期的任务(含子任务), 用于日历视图"""
        sql = ("SELECT t.*, l.name AS list_name FROM tasks t "
               "JOIN lists l ON l.id = t.list_id "
               "WHERE t.due_date IS NOT NULL AND date(t.due_date) BETWEEN ? AND ?")
        params = [start_iso, end_iso]
        if not show_completed:
            sql += " AND t.completed=0"
        if search:
            sql += " AND (t.title LIKE ? OR t.notes LIKE ?)"
            like = f"%{search}%"
            params.extend([like, like])
        sql += " ORDER BY t.due_date ASC, t.priority DESC"
        return [dict(r) for r in self.conn.execute(sql, params).fetchall()]

    def get_timeline_tasks(self, search="", show_completed=True):
        """时间线视图: 全部任务(含子任务)及其时间信息"""
        sql = ("SELECT t.*, l.name AS list_name FROM tasks t "
               "JOIN lists l ON l.id = t.list_id "
               "ORDER BY CASE WHEN t.parent_id IS NULL THEN t.id ELSE t.parent_id END, t.id")
        params = []
        conds = []
        if not show_completed:
            conds.append("t.completed=0")
        if search:
            conds.append("(t.title LIKE ? OR t.notes LIKE ?)")
            like = f"%{search}%"
            params = [like, like]
        if conds:
            sql = sql.replace("ORDER BY",
                              "WHERE " + " AND ".join(conds) + " ORDER BY")
        rows = [dict(r) for r in self.conn.execute(sql, params).fetchall()]
        subs = {}
        for t in rows:
            t["start"] = t["created_at"].split(" ")[0] if t["created_at"] else None
            t["end"] = None
            if t["completed"] and t["completed_at"]:
                t["end"] = t["completed_at"].split(" ")[0]
            elif t["due_date"]:
                t["end"] = t["due_date"].split(" ")[0]
            if t["parent_id"]:
                subs.setdefault(t["parent_id"], []).append(t)
        parents = [t for t in rows if not t["parent_id"]]
        for p in parents:
            children = subs.get(p["id"], [])
            p["children"] = children
            p["sub_count"] = len(children)
            p["sub_done"] = sum(1 for c in children if c["completed"])
            if not p["end"] and children:
                child_ends = [c["end"] or c["due_date"] for c in children if c["end"] or c["due_date"]]
                if child_ends:
                    p["end"] = max(child_ends)
        return parents

    # ---------------- 统计 ----------------
    def completion_stats(self):
        """统计面板数据: 近4周完成数 / 平均完成时长 / 优先级分布 (主任务口径)"""
        from datetime import timedelta
        today = date.today()
        weekly = []
        for i in range(3, -1, -1):
            ws = today - timedelta(days=today.weekday() + 7 * i)
            we = ws + timedelta(days=6)
            c = self.conn.execute(
                "SELECT COUNT(*) c FROM tasks WHERE completed=1 AND completed_at IS NOT NULL "
                "AND parent_id IS NULL AND date(completed_at) BETWEEN ? AND ?",
                (ws.isoformat(), we.isoformat())).fetchone()["c"]
            weekly.append({"start": ws, "end": we, "count": c})
        avg_days = self.conn.execute(
            "SELECT AVG(julianday(completed_at) - julianday(created_at)) a "
            "FROM tasks WHERE completed=1 AND completed_at IS NOT NULL AND parent_id IS NULL"
        ).fetchone()["a"]
        prio = []
        for pid in (3, 2, 1, 0):
            c = self.conn.execute(
                "SELECT COUNT(*) c FROM tasks WHERE priority=? AND parent_id IS NULL",
                (pid,)).fetchone()["c"]
            prio.append({"prio": pid, "name": PRIORITY_NAMES[pid], "count": c})
        return {
            "weekly": weekly,
            "avg_days": round(avg_days, 1) if avg_days is not None else None,
            "priority": prio,
        }

    def export_data(self):
        """导出全部数据 (JSON 友好结构)"""
        return {
            "exported_at": now_str(),
            "lists": [dict(r) for r in self.conn.execute("SELECT * FROM lists").fetchall()],
            "tasks": [dict(r) for r in self.conn.execute(
                "SELECT t.*, l.name AS list_name FROM tasks t "
                "JOIN lists l ON l.id=t.list_id ORDER BY t.id").fetchall()],
        }

    def daily_activity(self, days=371):
        """近 N 天按天活动量(主任务口径): {date_str: {"completed": n, "created": n}}"""
        from datetime import timedelta
        start = (date.today() - timedelta(days=days - 1)).isoformat()
        out = {}
        for r in self.conn.execute(
                "SELECT date(created_at) d, COUNT(*) c FROM tasks"
                " WHERE parent_id IS NULL AND created_at IS NOT NULL"
                " AND date(created_at)>=? GROUP BY d", (start,)):
            out.setdefault(r["d"], {"completed": 0, "created": 0})["created"] = r["c"]
        for r in self.conn.execute(
                "SELECT date(completed_at) d, COUNT(*) c FROM tasks"
                " WHERE parent_id IS NULL AND completed=1 AND completed_at IS NOT NULL"
                " AND date(completed_at)>=? GROUP BY d", (start,)):
            out.setdefault(r["d"], {"completed": 0, "created": 0})["completed"] = r["c"]
        return out

    def stats(self):
        """底部统计. 口径:
        - 待办/已完成/星标: 未完成/全部的父任务数(与主列表一致)
        - 今日到期/逾期: 自身或任一未完成子任务命中(与智能视图卡片数一致)"""
        today = date.today().isoformat()
        total = self.conn.execute("SELECT COUNT(*) c FROM tasks WHERE parent_id IS NULL").fetchone()["c"]
        done = self.conn.execute(
            "SELECT COUNT(*) c FROM tasks WHERE parent_id IS NULL AND completed=1").fetchone()["c"]
        today_due = self.conn.execute(
            "SELECT COUNT(*) c FROM tasks t WHERE t.parent_id IS NULL AND t.completed=0 AND ("
            " (t.due_date IS NOT NULL AND date(t.due_date)=?)"
            " OR EXISTS(SELECT 1 FROM tasks s WHERE s.parent_id=t.id AND s.completed=0"
            "           AND s.due_date IS NOT NULL AND date(s.due_date)=?))",
            (today, today)).fetchone()["c"]
        overdue = self.conn.execute(
            "SELECT COUNT(*) c FROM tasks t WHERE t.parent_id IS NULL AND t.completed=0 AND ("
            " (t.due_date IS NOT NULL AND date(t.due_date)<?)"
            " OR EXISTS(SELECT 1 FROM tasks s WHERE s.parent_id=t.id AND s.completed=0"
            "           AND s.due_date IS NOT NULL AND date(s.due_date)<?))",
            (today, today)).fetchone()["c"]
        starred = self.conn.execute(
            "SELECT COUNT(*) c FROM tasks WHERE parent_id IS NULL AND starred=1").fetchone()["c"]
        return {"total": total, "done": done, "today_due": today_due,
                "overdue": overdue, "starred": starred, "pending": total - done}

    def close(self):
        self.conn.close()


def due_label(due_str):
    """截止日期(可含时间) -> (显示文本, 状态)  状态: overdue/today/future"""
    if not due_str:
        return "", ""
    parts = str(due_str).split(" ")
    try:
        d = date.fromisoformat(parts[0])
    except ValueError:
        return due_str, "future"
    time_part = parts[1][:5] if len(parts) > 1 else ""
    today = date.today()
    delta = (d - today).days
    if delta < 0:
        text = f"逾期 {abs(delta)} 天"
        status = "overdue"
    elif delta == 0:
        text = "今天"
        status = "today"
    elif delta == 1:
        text = "明天"
        status = "future"
    elif delta == 2:
        text = "后天"
        status = "future"
    elif delta <= 7:
        names = ["周一", "周二", "周三", "周四", "周五", "周六", "周日"]
        text = names[d.weekday()]
        status = "future"
    else:
        text = d.strftime("%m-%d")
        status = "future"
    if time_part and time_part != "00:00":
        text += f" {time_part}"
    return text, status


def parse_due(due_str):
    """'YYYY-MM-DD[ HH:MM]' -> (date, time|None); 非法日期返回 (None, None)"""
    if not due_str:
        return None, None
    parts = str(due_str).split(" ")
    try:
        d = date.fromisoformat(parts[0])
    except ValueError:
        return None, None
    t = None
    if len(parts) > 1 and parts[1][:5] != "00:00":
        try:
            hh, mm = parts[1][:5].split(":")
            t = (int(hh), int(mm))
        except ValueError:
            t = None
    return d, t


def this_weekday(weekday):
    """本周指定星期几(周一为一周开始), weekday: 0=周一"""
    today = date.today()
    return today + timedelta(days=weekday - today.weekday())


def next_workday(weekday):
    """下个指定星期几的日期, weekday: 0=周一"""
    today = date.today()
    for i in range(1, 15):
        d = today + timedelta(days=i)
        if d.weekday() == weekday:
            return d
    return today

