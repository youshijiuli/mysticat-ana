# -*- coding: utf-8 -*-
"""几何绘制的扁平图标（避免 emoji 图标）"""
from PySide6.QtCore import QPointF, QRectF, Qt
from PySide6.QtGui import QBrush, QColor, QIcon, QPainter, QPainterPath, QPen, QPixmap


def _pixmap(size=40):
    pm = QPixmap(size, size)
    pm.fill(Qt.transparent)
    return pm


def _painter(pm):
    p = QPainter(pm)
    p.setRenderHint(QPainter.Antialiasing)
    return p


def _icon(pm):
    return QIcon(pm)


def inbox_icon(color="#7A8699", size=40):
    pm = _pixmap(size); p = _painter(pm)
    c = QColor(color); pen = QPen(c, 2.6, Qt.SolidLine, Qt.RoundCap, Qt.RoundJoin)
    p.setPen(pen); p.setBrush(Qt.NoBrush)
    r = QRectF(6, 6, 28, 28)
    path = QPainterPath()
    path.moveTo(10, 8); path.lineTo(30, 8); path.lineTo(34, 22); path.lineTo(34, 30)
    path.quadTo(34, 32, 32, 32); path.lineTo(8, 32); path.quadTo(6, 32, 6, 30)
    path.lineTo(6, 22); path.closeSubpath()
    p.drawPath(path)
    p.drawLine(QPointF(6, 22), QPointF(15, 22))
    p.drawLine(QPointF(25, 22), QPointF(34, 22))
    p.drawArc(QRectF(15, 17, 10, 10), 180 * 16, 180 * 16)
    p.end(); return _icon(pm)


def today_icon(color="#7A8699", size=40):
    pm = _pixmap(size); p = _painter(pm)
    c = QColor(color); pen = QPen(c, 2.6, Qt.SolidLine, Qt.RoundCap, Qt.RoundJoin)
    p.setPen(pen); p.setBrush(Qt.NoBrush)
    p.drawRoundedRect(QRectF(7, 9, 26, 24), 4, 4)
    p.drawLine(QPointF(7, 17), QPointF(33, 17))
    p.drawLine(QPointF(14, 6), QPointF(14, 12))
    p.drawLine(QPointF(26, 6), QPointF(26, 12))
    p.setBrush(QBrush(c)); p.setPen(Qt.NoPen)
    p.drawEllipse(QPointF(20, 24), 3.4, 3.4)
    p.end(); return _icon(pm)


def overdue_icon(color="#EF4444", size=40):
    pm = _pixmap(size); p = _painter(pm)
    c = QColor(color); pen = QPen(c, 2.6, Qt.SolidLine, Qt.RoundCap, Qt.RoundJoin)
    p.setPen(pen); p.setBrush(Qt.NoBrush)
    p.drawEllipse(QRectF(8, 8, 24, 24))
    p.drawLine(QPointF(20, 14), QPointF(20, 22))
    p.drawPoint(QPointF(20, 26))
    p.end(); return _icon(pm)


def star_icon(color="#7A8699", size=40, filled=False):
    pm = _pixmap(size); p = _painter(pm)
    c = QColor(color)
    path = QPainterPath()
    cx, cy, R, r = 20, 21, 12, 5.2
    import math
    for i in range(10):
        ang = math.pi / 2 + i * math.pi / 5
        rad = R if i % 2 == 0 else r
        pt = QPointF(cx + rad * math.cos(ang), cy - rad * math.sin(ang))
        if i == 0:
            path.moveTo(pt)
        else:
            path.lineTo(pt)
    path.closeSubpath()
    p.setPen(QPen(c, 2.2, Qt.SolidLine, Qt.RoundCap, Qt.RoundJoin))
    p.setBrush(QBrush(c) if filled else Qt.NoBrush)
    p.drawPath(path)
    p.end(); return _icon(pm)


def done_icon(color="#7A8699", size=40):
    pm = _pixmap(size); p = _painter(pm)
    c = QColor(color)
    p.setPen(QPen(c, 2.6, Qt.SolidLine, Qt.RoundCap, Qt.RoundJoin))
    p.setBrush(Qt.NoBrush)
    p.drawEllipse(QRectF(7, 7, 26, 26))
    p.drawLine(QPointF(13, 21), QPointF(18, 26))
    p.drawLine(QPointF(18, 26), QPointF(28, 14))
