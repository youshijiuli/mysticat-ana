def _section_module(name, source):
    """把一个分节注册为真实模块, 使节内的 import styles as st 等语句原样可用"""
    mod = types.ModuleType(name)
    mod.__file__ = f"<TaskFlow:{name}>"
    sys.modules[name] = mod
    exec(compile(source, f"<TaskFlow:{name}>", "exec"), mod.__dict__)


