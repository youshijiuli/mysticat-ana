        year_row.addWidget(year_label)
        year_row.addStretch()
        year_row.addWidget(y_next)
        v.addLayout(year_row)

        # 12 月网格
        grid = QGridLayout()
        grid.setSpacing(4)
        month_btns = []
        for i in range(12):
            b = QPushButton(f"{i + 1}月")
            b.setFixedHeight(34)
            b.setCursor(Qt.PointingHandCursor)
            def make_pick(m):
                def pick():
                    self.view_year = state["year"]
                    self.view_month = m
                    dlg.accept()
                return pick
            b.clicked.connect(make_pick(i + 1))
            grid.addWidget(b, i // 4, i % 4)
            month_btns.append(b)
        v.addLayout(grid)
        refresh_year()

        dlg.adjustSize()
        pos = self.month_label.mapToGlobal(self.month_label.rect().center())
        dlg.move(pos.x() - dlg.width() // 2, pos.y() - dlg.height() // 2)
        if dlg.exec() == QDialog.Accepted:
            self._update_month_label()
            self._render_grid()

    # ---------- 渲染 ----------
    def _render_grid(self):
        year, month = self.view_year, self.view_month
        first = date(year, month, 1)
        # 周一为第一列
        lead = first.weekday()  # 0=周一
        days_in_month = cal_mod.monthrange(year, month)[1]
        prev_year, prev_month = (year - 1, 12) if month == 1 else (year, month - 1)
        prev_days = cal_mod.monthrange(prev_year, prev_month)[1]
        today = date.today()
        self.cell_dates = []
        for i in range(42):
            day_num = i - lead + 1
            if day_num < 1:
                d = date(prev_year, prev_month, prev_days + day_num)
                in_month = False
            elif day_num > days_in_month:
                d = date(year, month, day_num - days_in_month)
                in_month = False
            else:
                d = date(year, month, day_num)
                in_month = True
            self.cell_dates.append(d)
            btn = self.day_buttons[i]
            btn.setText(str(d.day))
            selected = (d == self.sel_date)
            is_today = (d == today)
            if selected:
                style = f"""
                    QPushButton {{ color: #FFFFFF; background: {st.PRIMARY};
                        border: none; border-radius: 8px; font-size: 13px; font-weight: 700; }}
                    QPushButton:hover {{ background: {st.PRIMARY_HOVER}; }}
                """
            elif is_today:
                style = f"""
                    QPushButton {{ color: {st.PRIMARY}; background: {st.PRIMARY_SOFT};
                        border: 1px solid {st.PRIMARY}; border-radius: 8px;
                        font-size: 13px; font-weight: 700; }}
                    QPushButton:hover {{ background: #D8E7FD; }}
                """
            elif not in_month:
                style = f"""
                    QPushButton {{ color: {st.TEXT_FAINT}; background: transparent;
                        border: none; border-radius: 8px; font-size: 13px; }}
                    QPushButton:hover {{ background: {st.PRIMARY_SOFT}; }}
                """
            else:
                style = f"""
                    QPushButton {{ color: {st.TEXT}; background: transparent;
                        border: none; border-radius: 8px; font-size: 13px; }}
                    QPushButton:hover {{ background: {st.PRIMARY_SOFT}; }}
                """
            btn.setStyleSheet(style)

    # ---------- 交互 ----------
    def _pick_day(self, idx):
        self.sel_date = self.cell_dates[idx]
        self.cleared = False
        self._render_grid()

    def _on_nav(self, delta):
        m = self.view_month + delta
        if m < 1:
            self.view_year, self.view_month = self.view_year - 1, 12
        elif m > 12:
            self.view_year, self.view_month = self.view_year + 1, 1
        else:
            self.view_month = m
        self._update_month_label()
        self._render_grid()

    def _on_allday(self, checked):
        self.all_day = checked
        self._sync_time_ui()

    def _sync_time_ui(self):
        for w in (self.hour_spin, self.minute_spin, self.colon_label):
            w.setEnabled(not self.all_day)
            w.setVisible(not self.all_day)
        self.hour_spin.setValue(self.hour)
        self.minute_spin.setValue(self.minute)

    def _on_time_change(self):
        self.hour = self.hour_spin.value()
        self.minute = self.minute_spin.value()

    def _on_clear(self):
        self.cleared = True
        self.reject()

    def _on_today(self):
        self.sel_date = date.today()
        self.view_year, self.view_month = self.sel_date.year, self.sel_date.month
        self._update_month_label()
        self._render_grid()

    # ---------- 结果 ----------
    def get_result(self):
        """None=清除; 否则 'YYYY-MM-DD' 或 'YYYY-MM-DD HH:MM'"""
        if self.cleared:
            return None
        if self.all_day:
            return self.sel_date.isoformat()
        return f"{self.sel_date.isoformat()} {self.hour:02d}:{self.minute:02d}"

    # ---------- 定位 ----------
    def showEvent(self, e):
        super().showEvent(e)
        self.adjustSize()

    def popup_for(self, anchor):
        """在 anchor 按钮(全局坐标)下方弹出"""
        self.adjustSize()
        pos = anchor.mapToGlobal(anchor.rect().bottomLeft())
        screen = self.screen() or self.window().windowHandle().screen()
        if screen:
            geo = screen.availableGeometry()
            x = min(max(pos.x(), geo.left() + 8), geo.right() - self.width() - 8)
            y = pos.y() + 6
            if y + self.height() > geo.bottom():
                y = max(geo.top() + 8, pos.y() - self.height() - 6)
            self.move(x, y)
        return self.exec()

